stage {
    on action(input) {
        log("stage: start");
        broadcast("job");
    }
}

sprite WorkerA {
    let count = 0;

    on message "job" {
        count += 1;
        log(join("WorkerA count = ", count));
    }
}

sprite WorkerB {
    let count = 100;

    on message "job" {
        count += 10;
        log(join("WorkerB count = ", count));
    }
}
