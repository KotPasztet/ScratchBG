stage {
    #include <std>
    using namespace std;

    on action(input) {
        console.log("stage: start");
        broadcast("job");
    }
}

sprite WorkerA {
    int count = 0;

    on message "job" {
        count += 1;
        console.log(join("WorkerA count = ", count));
    }
}

sprite WorkerB {
    int count = 100;

    on message "job" {
        count += 10;
        console.log(join("WorkerB count = ", count));
    }
}
