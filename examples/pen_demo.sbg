stage {
    import "../packages/std/main.sbg";

    on action(input) {
        clearTerminal();
        log("Pen demo: drawing is done by invisible sprite Painter.");
        broadcast("draw");
        return "ok";
    }
}

sprite Painter {
    import "../packages/std/sprite.sbg";
    import "../packages/std/math.sbg";
    import "../packages/std/pen.sbg";

    on message "draw" {
        show();
        spriteResetPosition();
        penReset();
        penUse("#ff6600", 2);
        penGrid(-120, 120, -90, 90, 30);
        penSetColor("#0066ff");
        penCircle(0, 0, 70, 36);
        hide();
    }
}
