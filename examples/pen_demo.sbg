stage {
    #include <std>
    using namespace std;

    on action(input) {
        console.clear();
        console.log("Pen demo: drawing is done by invisible sprite Painter.");
        broadcast("draw");
        return "ok";
    }
}

sprite Painter {
    #include <std/sprite>
    #include <std/pen>
    using namespace std;

    on message "draw" {
        show();
        spriteResetPosition();
        pen.reset();
        pen.use("#ff6600", 2);
        pen.grid(-120, 120, -90, 90, 30);
        pen.color("#0066ff");
        pen.circle(0, 0, 70, 36);
        hide();
    }
}
