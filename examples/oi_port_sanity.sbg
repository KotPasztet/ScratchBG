#include <bits/stdc++.h>
using namespace std;

// Not a built-in OI solution. This is a sanity test made from common OI/C++
// building blocks: vector, sort/lower_bound, DSU, Fenwick, priority_queue.

int main() {
    vector<int> v = {8, 1, 5, 3, 5, 2};
    v.sort();

    int lb = v.lower_bound(5);
    int ub = v.upper_bound(5);

    dsu d;
    d.init(5);
    d.unite(1, 2);
    d.unite(2, 5);
    bool connected = d.same(1, 5);

    fenwick fw;
    fw.init(5);
    for (int i = 1; i < v.size(); i++) {
        fw.add(i, v.at(i));
    }
    int pref3 = fw.sum(3);

    priority_queue pq;
    for (auto x : v) {
        pq.push(x, x);
    }

    int first = pq.top();
    pq.pop();
    int second = pq.top();

    if (lb == 4 && ub == 6 && connected && pref3 == 6 && first == 1 && second == 2) {
        return "OK cpp-like algorithmic surface";
    }
    return join("FAIL lb=", join(lb, join(" ub=", join(ub, join(" pref=", pref3)))));
}
