stage {
    #include <std>
    using namespace std;

    on action(input) {
        console.clear();
        broadcast("draw.step");
        return "motion tick sent";
    }
}

sprite Dot {
    int steps = 0;

    string stepOnce() {
        changeX(10);
        changeY(4);
        steps += 1;
        return join("Dot x=", join(x(), join(" y=", y())));
    }

    on flag {
        hide();
        goToXY(0, 0);
    }

    on message "draw.step" {
        console.log(stepOnce());
    }
}
