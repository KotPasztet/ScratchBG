#include <std>
using namespace std;

// Range-for and index-range iteration over vectors.

int main() {
    vector<int> xs = {5, 1, 4, 2, 3};

    int sum = 0;
    for (auto x : xs) {
        sum += x;
    }

    string indexed = "";
    for (int i = 1; i <= xs.size(); i++) {
        indexed = join(indexed, join("[", join(i, join(":", join(xs.at(i), "]")))));
    }

    int squares = 0;
    for (int i : range(1, 6)) {
        squares += i * i;
    }

    xs.sort();
    string sorted = "";
    for (auto x : xs) {
        sorted = join(sorted, join(x, " "));
    }

    return join("sum=", join(sum, join(" squares=", join(squares, join(" sorted=", sorted)))));
}
