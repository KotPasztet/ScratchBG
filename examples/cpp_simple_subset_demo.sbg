#include<bits/stdc++.h>
using namespace std;

vector<int> v = {5, 1, 4, 2, 3};

int main() {
    v.sort();
    v.push_back(10);

    int sum = 0;
    for (auto x : v) {
        sum += x;
    }

    priority_queue pq;
    pq.push(2, "B");
    pq.push(1, "A");
    pq.push(3, "C");

    string out = "";
    while (!pq.empty()) {
        out = join(out, pq.top());
        pq.pop();
    }

    return join("sum=", join(sum, join(" pq=", out)));
}
