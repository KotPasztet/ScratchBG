#include <std>
using namespace std;

on action(input) {
    if (input == "fixed") {
        setFixedDelta(0.0166667);
        return "fixed dt on";
    }
    if (input == "real") {
        useRealDelta();
        return "real dt on";
    }
    if (input == "scale") {
        setDeltaScale(0.5);
        return "time scale = 0.5";
    }
    return join("frame=", join(frame(), join(" dt=", join(dt(), join(" fps=", fps())))));
}

sprite Mover {
    #include <std/sprite>
    #include <std/time>
    using namespace std;

    on flag {
        spriteResetPosition();
        forever {
            changeX(80 * dt());
            if (x() > 230) { setX(-230); }
        }
    }
}
