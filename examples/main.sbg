stage {
    #include <std>
    using namespace std;

    string answerFor(string text) {
        if (text == "hello") {
            return "czesc, dzialam w Scratchu i natywnie";
        }
        if (text == "2+2") {
            return "4";
        }
        if (text == "worker") {
            broadcast("worker.tick");
            return "wyslano worker.tick";
        }
        return join("nie znam komendy: ", text);
    }

    on action(input) {
        return answerFor(input);
    }
}

sprite Worker {
    int counter = 0;
    vector<int> history = {};

    int nextValue() {
        counter += 1;
        history.push_back(counter);
        return counter;
    }

    on message "worker.tick" {
        int value = nextValue();
        console.log(join("worker value = ", value));
    }
}
