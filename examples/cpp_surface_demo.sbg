#include <bits/stdc++.h>
using namespace std;

int main() {
    vector<int> a = {5, 1, 4, 2, 3};
    a.sort();

    int sum = 0;
    for (auto x : a) {
        sum += x;
    }

    int p = a.lower_bound(3);
    bool has4 = a.binary_search(4);

    priority_queue pq;
    pq.push(30, "C");
    pq.push(10, "A");
    pq.push(20, "B");

    string order = "";
    while (!pq.empty()) {
        order = join(order, pq.top());
        pq.pop();
    }

    return join("sum=", join(sum, join(" p=", join(p, join(" has4=", join(has4, join(" pq=", order)))))));
}
