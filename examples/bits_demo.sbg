#include <bits/stdc++.h>
using namespace std;

// Priority queue, DSU, and Fenwick tree via the C++-style bits library.

int main() {
    priority_queue pq;
    pq.push(30, "C");
    pq.push(10, "A");
    pq.push(20, "B");

    string out = "";
    while (!pq.empty()) {
        out = join(out, pq.top());
        pq.pop();
    }

    dsu d;
    d.init(5);
    d.unite(1, 2);
    d.unite(2, 3);

    fenwick fw;
    fw.init(5);
    for (int i = 1; i <= 5; i++) {
        fw.add(i, i);
    }

    return join("pq=", join(out, join(" same13=", join(d.same(1, 3), join(" fw5=", fw.sum(5))))));
}
