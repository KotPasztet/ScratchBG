stage {
    #include <std>
    using namespace std;

    on action(input) {
        console.clear();
        console.log("STD DEMO");

        if (input == "math") {
            return join("clamp=", clamp(120, 0, 100));
        }
        if (startsWith(input, "echo ")) {
            return slice(input, 6, len(input));
        }
        if (input == "worker") {
            broadcast("worker.step");
            return "worker broadcasted";
        }
        return join("unknown: ", input);
    }
}

sprite Worker {
    int ticks = 0;

    on flag {
        hide();
        goToXY(0, 0);
    }

    string step() {
        ticks += 1;
        changeX(10);
        changeY(5);
        return join("tick=", join(ticks, join(" pos=", join(x(), join(",", y())))));
    }

    on message "worker.step" {
        console.log(step());
    }
}
