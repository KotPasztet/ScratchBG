import "std";

list nums = [1, 2, 3];
list other = [];

on action(input) {
    clearTerminal();
    log("professional std demo");

    push(nums, 4);
    popTo(nums, "last");
    copyList(nums, other);

    mapClear();
    mapSet("input", input);
    mapSet("last", last);
    mapSet("sum", listGet(other, 1) + listGet(other, 2) + listGet(other, 3));

    splitByChar("alpha,beta,gamma", ",");
    let parsed = parseInt("1234");

    expectEq("parseInt", parsed, 1234);
    expect("map has input", mapHas("input"));
    testSummary();

    return join("sum=", join(mapGet("sum"), join(" split=", len(str_split_res))));
}
