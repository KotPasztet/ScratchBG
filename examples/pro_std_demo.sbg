#include <std>
using namespace std;

vector<int> nums = {1, 2, 3};
vector<int> other = {};

on action(input) {
    console.clear();
    console.log("professional std demo");

    nums.push_back(4);
    popTo(nums, "last");
    copyList(nums, other);

    mapClear();
    mapSet("input", input);
    mapSet("last", last);
    mapSet("sum", other.at(1) + other.at(2) + other.at(3));

    splitByChar("alpha,beta,gamma", ",");
    int parsed = parseInt("1234");

    expectEq("parseInt", parsed, 1234);
    expect("map has input", mapHas("input"));
    testSummary();

    return join("sum=", join(mapGet("sum"), join(" split=", len(str_split_res))));
}
