// Math library. Scratch trigonometry uses degrees, so these wrappers use degrees too.
let PI = 3.141592653589793;
let E = 2.718281828459045;
let TAU = 6.283185307179586;

proc min2(a, b) {
    if (a < b) { return a; }
    return b;
}

proc max2(a, b) {
    if (a > b) { return a; }
    return b;
}

proc clamp(value, low, high) {
    if (value < low) { return low; }
    if (value > high) { return high; }
    return value;
}

proc saturate(value) {
    return clamp(value, 0, 1);
}

proc sign(value) {
    if (value > 0) { return 1; }
    if (value < 0) { return -1; }
    return 0;
}

proc lerp(a, b, t) { return a + ((b - a) * t); }

proc invLerp(a, b, value) {
    if (a == b) { return 0; }
    return (value - a) / (b - a);
}

proc mapRange(value, inMin, inMax, outMin, outMax) {
    return lerp(outMin, outMax, invLerp(inMin, inMax, value));
}

proc mapRangeClamped(value, inMin, inMax, outMin, outMax) {
    return lerp(outMin, outMax, saturate(invLerp(inMin, inMax, value)));
}

proc degToRad(deg) { return deg * PI / 180; }
proc radToDeg(rad) { return rad * 180 / PI; }
proc square(x) { return x * x; }
proc cube(x) { return x * x * x; }

proc powInt(base, exp) {
    let n = abs(exp);
    let out = 1;
    repeat(n) { out *= base; }
    if (exp < 0) { return 1 / out; }
    return out;
}

proc hypot2(dx, dy) { return sqrt((dx * dx) + (dy * dy)); }
proc distance2D(x1, y1, x2, y2) { return hypot2(x2 - x1, y2 - y1); }
proc floorDiv(a, b) { return floor(a / b); }

proc positiveMod(a, b) {
    let r = a % b;
    if (r < 0) { return r + b; }
    return r;
}

proc wrapAngle(deg) {
    let r = positiveMod(deg + 180, 360);
    return r - 180;
}

proc angleDiff(fromDeg, toDeg) {
    return wrapAngle(toDeg - fromDeg);
}

proc approach(current, target, delta) {
    if (abs(target - current) <= delta) { return target; }
    return current + (sign(target - current) * delta);
}

proc randInt(low, high) { return round(random(low, high)); }
proc chance(percent) { return random(1, 100) <= percent; }
proc nearlyEqual(a, b, eps) { return abs(a - b) <= eps; }

proc factorial(n) {
    let out = 1;
    for (let i = 2; i <= n; i += 1) { out *= i; }
    return out;
}

proc fibonacci(n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    let a = 0;
    let b = 1;
    for (let i = 2; i <= n; i += 1) {
        let c = a + b;
        a = b;
        b = c;
    }
    return b;
}
