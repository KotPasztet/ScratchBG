// Debug/assertion helpers. Kept small and deterministic for vanilla Scratch.

let debug_enabled = 1;
let test_passed = 0;
let test_failed = 0;

proc debugOn() { debug_enabled = 1; }
proc debugOff() { debug_enabled = 0; }
proc debugLog(value) {
    if (debug_enabled) { log(join("[DBG] ", value)); }
    return value;
}
proc fail(msg) {
    test_failed += 1;
    log(join("[FAIL] ", msg));
    return 0;
}
proc pass(msg) {
    test_passed += 1;
    log(join("[PASS] ", msg));
    return 1;
}
proc expect(name, cond) {
    if (cond) { return pass(name); }
    return fail(name);
}
proc expectEq(name, got, expected) {
    if (got == expected) { return pass(name); }
    return fail(join(name, join(" got=", join(got, join(" expected=", expected)))));
}
proc testSummary() {
    log(join("tests passed=", join(test_passed, join(" failed=", test_failed))));
    return test_failed == 0;
}

proc assertTrue(cond, message) {
    // SUGESTIA: pkt 10 - assert helper for easy testing
    if (!cond) {
        log(join("ASSERT FAILED: ", message));
        return 0;
    }
    return 1;
}
