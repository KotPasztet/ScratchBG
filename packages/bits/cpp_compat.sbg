// C++ compatibility helpers for code emitted by the patch20 surface.
// These are generic ABI helpers, not solved algorithms.

proc at0(vec, idx) {
    let want = idx + 1;
    let cur = 1;
    let token = "";
    let i = 1;

    while (i <= len(vec) + 1) {
        let ch = "";
        if (i <= len(vec)) {
            ch = letter(vec, i);
        } else {
            ch = " ";
        }

        if (ch == " " || ch == "," || ch == ";") {
            if (len(token) > 0) {
                if (cur == want) {
                    return token + 0;
                }
                token = "";
                cur += 1;
            }
        } else {
            token = join(token, ch);
        }
        i += 1;
    }

    return 0;
}

proc vec_size(vec) {
    let cur = 0;
    let inToken = 0;
    let i = 1;
    while (i <= len(vec)) {
        let ch = letter(vec, i);
        if (ch == " " || ch == "," || ch == ";") {
            if (inToken == 1) {
                cur += 1;
                inToken = 0;
            }
        } else {
            inToken = 1;
        }
        i += 1;
    }
    if (inToken == 1) { cur += 1; }
    return cur;
}
